# Copy to .env and fill in real values: cp .env.example .env
# .env is gitignored (see ../.gitignore) - never commit the filled-in copy.

# --- GitHub webhook -----------------------------------------------------
GITHUB_WEBHOOK_SECRET=

# --- review-api (Elad's backend) -----------------------------------------
REVIEW_API_BASE_URL=http://localhost:8000
REVIEW_API_KEY=

# --- GitHub OAuth ---------------------------------------------------------
# From https://github.com/settings/developers -> your OAuth App.
# client_id is not sensitive; client_secret is - never commit either file
# once filled in, but especially the secret.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Must exactly match the app's "Authorization callback URL".
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8080/auth/github/callback

# --- Sessions --------------------------------------------------------------
GATEWAY_SESSION_TTL_SECONDS=28800
# true once served over https - keep false for local http:// dev.
GATEWAY_COOKIE_SECURE=false

# --- Misc --------------------------------------------------------------
GATEWAY_DATABASE_URL=sqlite:///./gateway.db
GATEWAY_DEFAULT_MODE=brief

# --- CORS + frontend redirect ----------------------------------------------
# Comma-separated origins allowed to call the gateway WITH cookies. Vite's
# default dev port; add the deployed frontend's origin when there is one.
GATEWAY_CORS_ORIGINS=http://localhost:5173
# Where /auth/github/callback sends the browser after a successful login.
GATEWAY_FRONTEND_URL=http://localhost:5173
